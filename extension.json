{
	"name": "EduSharing",
	"version": "2.0",
	"author": [
		"https://edu-sharing.net",
		"https://idea-sketch.com"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:EduSharing",
	"descriptionmsg": "edusharing-desc",
	"requires": {
		"MediaWiki": ">= 1.43.0",
		"extensions": {
		}
	},
	"license-name": "MIT",
	"type": "",
	"SpecialPages": {
		"EduSharingRegister": {
			"class": "MediaWiki\\Extension\\EduSharing\\SpecialEduSharingRegister"
		},
		"EduProxy": {
			"class": "MediaWiki\\Extension\\EduSharing\\SpecialEduProxy"
		},
		"EduServiceWorker": {
			"class": "MediaWiki\\Extension\\EduSharing\\SpecialEduServiceWorker"
		},
		"EduInlineHelper": {
			"class": "MediaWiki\\Extension\\EduSharing\\SpecialEduInlineHelper"
		}
	},
	"MessagesDirs": {
		"EduSharing": [
			"i18n"
		]
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\EduSharing\\": "includes/"
	},
	"AutoloadClasses": {
		"MediaWiki\\Extension\\EduSharing\\SpecialEduSharingRegister": "includes/specials/SpecialEduSharingRegister.php",
		"MediaWiki\\Extension\\EduSharing\\SpecialEduProxy": "includes/specials/SpecialEduProxy.php",
		"MediaWiki\\Extension\\EduSharing\\SpecialEduServiceWorker": "includes/specials/SpecialEduServiceWorker.php",
		"MediaWiki\\Extension\\EduSharing\\SpecialEduInlineHelper": "includes/specials/SpecialEduInlineHelper.php"
	},
	"Hooks": {
		"ResourceLoaderGetConfigVars": "handleEduSharingHooks",
		"MakeGlobalVariablesScript": "handleEduSharingHooks",
		"ParserFirstCallInit": "handleEduSharingHooks",
		"ParserPreSaveTransformComplete": "handleEduSharingHooks",
		"PageSaveComplete": "handleEduSharingHooks",
		"PageDelete": "handleEduSharingHooks",
		"PageUndeleteComplete": "handleEduSharingHooks",
		"BeforePageDisplay": "handleEduSharingHooks",
		"LoadExtensionSchemaUpdates": "handleEduSharingInstallHooks"
	},
	"HookHandlers": {
		"handleEduSharingHooks": {
			"class": "MediaWiki\\Extension\\EduSharing\\EduSharingHooks"
		},
		"handleEduSharingInstallHooks": {
			"class": "MediaWiki\\Extension\\EduSharing\\EduSharingInstallHooks"
		}
	},
	"attributes": {
		"VisualEditor": {
			"PluginModules": [
				"ext.eduSharing.visualEditor"
			]
		}
	},
	"ResourceModules": {
		"ext.eduSharing.display": {
			"styles": "resources/less/ext.eduSharing.display.less",
			"scripts": "resources/js/ext.eduSharing.display.js",
			"dependencies": [],
			"messages": [],
			"targets": [
				"mobile",
				"desktop"
			],
			"position": "top"
		},
		"ext.eduSharing.render": {
			"scripts": "resources/js/ext.eduSharing.render.js",
			"dependencies": [],
			"messages": [],
			"targets": [
				"mobile",
				"desktop"
			]
		},
		"ext.eduSharing.visualEditor": {
			"scripts": [
				"modules/ve.ce.MWEduSharingNode.js",
				"modules/ve.dm.MWEduSharingNode.js",
				"modules/ve.ui.MWEduSharingDialog.js",
				"modules/ve.ui.MWEduSharingDialogTool.js"
			],
			"styles": [
				"modules/ve.ui.MWEduSharing.less",
				"modules/ve.ui.MWEduSharingIcons.less"
			],
			"dependencies": [
				"oojs-ui.styles.icons-editing-advanced",
				"ext.visualEditor.mwcore",
				"ext.visualEditor.mwimage.core",
				"mediawiki.widgets.Table"
			],
			"messages": [
				"visualeditor-mwedusharingdialog-button",
				"visualeditor-mwedusharingdialog-title",
				"visualeditor-mwedusharingdialog-help-title",
				"visualeditor-mwedusharingdialog-select",
				"visualeditor-mwedusharingdialog-change",
				"visualeditor-mwedusharingdialog-options",
				"visualeditor-mwedusharingdialog-action",
				"visualeditor-mwedusharingdialog-id",
				"visualeditor-mwedusharingdialog-caption",
				"visualeditor-mwedusharingdialog-mimetype",
				"visualeditor-mwedusharingdialog-version",
				"visualeditor-mwedusharingdialog-repotype",
				"visualeditor-mwedusharingdialog-versionshow",
				"visualeditor-mwedusharingdialog-versionshow-latest",
				"visualeditor-mwedusharingdialog-versionshow-current",
				"visualeditor-mwedusharingdialog-size",
				"visualeditor-mwedusharingdialog-align"
			],
			"targets": [
				"mobile",
				"desktop"
			]
		}
	},
	"config": {
		"EduSharingBaseUrl": {
			"description": "Defines the URL of the edu-sharing repository",
			"value": "https://example.com/edu-sharing"
		},
		"EduSharingAppId": {
			"description": "Defines the AppID with which this wiki is registered at the edu-sharing repository",
			"value": "mediawiki-app-id"
		},
		"EduSharingAppDomain": {
			"description": "Defines the fqdn under which the wiki is running",
			"value": "wiki.example.com"
		},
		"EduSharingAppHost": {
			"description": "The public ip address of the wiki host",
			"value": "192.168.0.1"
		},
		"EduSharingIconMimeAudio": {
			"description": "Audio Icon",
			"value": "audio.png"
		},
		"EduSharingIconMimeVideo": {
			"description": "Video Icon",
			"value": "video.png"
		},
		"EduSharingPrivateKeyFile": {
			"description": "Path to file containing the private key, relative to MW install dir",
			"value": "extensions/EduSharing/conf/private.key"
		},
		"EduSharingPublicKeyFile": {
			"description": "Path to file containing the public key, relative to MW install dir",
			"value": "extensions/EduSharing/conf/public.key"
		},
		"EduSharingRepoPublicKeyFile": {
			"description": "Path to file containing the repository's public key, relative to MW install dir",
			"value": "extensions/EduSharing/conf/repopublic.key"
		},
		"EduSharingRepoId": {
			"description": "Repository id used for rendering service requests",
			"value": "local"
		},
		"EduSharingRedirectEndpoint": {
			"description": "Override redirect endpoint (defaults to /public/redirect)",
			"value": "/public/redirect"
		},
		"EduSharingPreviewEndpoint": {
			"description": "Override preview endpoint (defaults to /public/preview)",
			"value": "/public/preview"
		},
		"EduSharingOpenResourceInNewTab": {
			"description": "Open resource links in a new browser tab/window",
			"value": false
		},
		"EduSharingGuestUserName": {
			"description": "Username to use for anonymous repository access",
			"value": "esguest"
		},
		"EduSharingForceGuestUser": {
			"description": "Always use anonymous repository access",
			"value": false
		},
		"EduSharingEnableServiceWorker": {
			"description": "Enable registration of the edu-sharing rendering service worker",
			"value": true
		}
	},
	"ConfigRegistry": {
		"edusharing": "GlobalVarConfig::newInstance"
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "EduSharing"
	},
	"manifest_version": 2
}
